# ==========================================
# Dream Bazar - Environment Configuration
# ==========================================

# Port Configuration
SERVER_PORT=4000
CLIENT_PORT=3000 # Note: Port 7000 is reserved by AirPlay Receiver on macOS
CLIENT_PROD_PORT=80
MONGODB_PORT=27017
MONGO_EXPRESS_PORT=8081

# Database Configuration
DB_NAME=dream-bazar
DB_CONN_STRING=mongodb://mongodb:27017/dream-bazar

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_please_change_in_production
FRONTEND_URL=http://localhost:7000
CALLBACK_URL=http://localhost:4000/api/v1/auth/

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth (Optional)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Cloudinary (Optional - for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
