# Server Environment Variables
PORT=4000
NODE_ENV=development

# MongoDB
DB_NAME=dream-bazar
DB_CONN_STRING=mongodb://mongodb:27017/dream-bazar

# Auth
JWT_SECRET=your_super_secret_jwt_key_please_change_in_production
